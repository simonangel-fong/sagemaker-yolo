server {
    # 8080, not 80: the cluster runs this as non-root under PSS restricted,
    # which cannot bind a privileged port.
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Base64 inflates an image by ~33%, so the JSON body is larger than the
    # file the user picked. The predictor caps decoded bytes at 10 MB.
    client_max_body_size 16m;

    location / {
        try_files $uri $uri/ =404;
    }

    # Proxy the API so the browser sees one origin and CORS never applies.
    #
    # The upstream differs by environment -- "inference:8080" under compose,
    # "yolo-car-plate-predictor.yolo-serving.svc.cluster.local:80" in the
    # cluster -- so it comes from PREDICTOR_UPSTREAM. nginx's entrypoint
    # renders /etc/nginx/templates/*.template into conf.d at container start.
    location /v1/ {
        proxy_pass http://${PREDICTOR_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;

        # A cold CPU inference on a large image takes a few hundred ms; the
        # default 60s is ample, but be explicit rather than inherit it.
        proxy_read_timeout 120s;
    }
}
